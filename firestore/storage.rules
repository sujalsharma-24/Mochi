rules_version = '2';

// Mochi Cloud Storage Security Rules
// Mirrors the deny-by-default posture of firestore.rules (docs/TRD.md §3/§5).
// Moderation (Google Cloud Vision) runs server-side in the onThemePublish Cloud Function
// after upload — these rules only gate *who can upload where*, not content safety.

service firebase.storage {
  match /b/{bucket}/o {

    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User avatars: only the owning user may upload, anyone may view (public profile).
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Theme preview / background images: only the owning creator may upload;
    // publicly readable once written (moderation-gated visibility is enforced
    // in Firestore via themes.moderationStatus, not here).
    match /themes/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
